# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
BRAND_NAME="WASIT X"
# SANDBOX | PRODUCTION. PRODUCTION refuses to boot unless every gate in SystemConfig is set
# and no sandbox adapter is configured (see docs/REGULATORY-CHECKLIST.md §9).
TRADING_MODE=SANDBOX

# Local cluster from `pnpm db:start` (dev-only credentials)
DATABASE_URL=postgresql://wasitx:wasitx_dev_only@127.0.0.1:5544/wasitx
# Optional. When unset the API uses in-process fallbacks (DB-backed scheduler, memory rate limits).
REDIS_URL=

# Comma-separated origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Cookie domain (omit for host-only cookies in local dev)
COOKIE_DOMAIN=
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ── Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# In production these come from the secrets manager, never from a file.
TOKEN_SIGNING_KEY=change-me-dev-only-token-signing-key-000000000
# 32-byte base64 key for AES-256-GCM field & file encryption
DATA_ENCRYPTION_KEY=ZGV2LW9ubHktZGF0YS1lbmNyeXB0aW9uLWtleS0zMmI=
# Keyed HMAC for lookup hashes (national ID, bank account)
LOOKUP_HMAC_KEY=change-me-dev-only-lookup-hmac-key-0000000000

# ── Integrations (sandbox adapters until contracts exist) ───────────────────
KYC_PROVIDER=sandbox
SCREENING_PROVIDER=sandbox
CUSTODY_PROVIDER=sandbox
WALLET_SCREENING_PROVIDER=sandbox
SMS_PROVIDER=sandbox
EMAIL_PROVIDER=sandbox
# Expo push is a real public API; set to "expo" to deliver pushes, "sandbox" to log only.
PUSH_PROVIDER=sandbox
MALWARE_SCANNER=sandbox
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
