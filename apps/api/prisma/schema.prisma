// WASIT X — PostgreSQL schema.
// Conventions:
//  * Money is BigInt minor units: *Usdt = micro-USDT (6dp), *Agorot = ILS agorot, priceE4 = ILS/USDT × 10^4.
//  * Append-only tables (AuditEvent, TradeEvent, JournalEntry, LedgerLine, KycEvent) are protected by
//    triggers in migration `0002_integrity` (no UPDATE/DELETE; ledger entries must balance).
//  * PII that is not needed for search is encrypted at the application layer (AES-256-GCM, *Enc fields);
//    *Hash fields are keyed HMACs used for uniqueness/lookup without storing plaintext.
//  * "Order" in the brief = Trade here; BUY and SELL offers share the Offer table (side column).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

